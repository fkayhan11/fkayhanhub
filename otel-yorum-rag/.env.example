# ============================================================
# ORTAM DEĞİŞKENLERİ ÖRNEĞİ
# Bu dosyayı ".env" olarak kopyalayıp kendi değerlerinizi girin.
# .env dosyasını ASLA git'e commitlemeyin!
# ============================================================

# Google AI Studio üzerinden alınan API anahtarınız
GEMINI_API_KEY=your_api_key_here

# ------------------------------------------------------------
# ONEMLI NOT: "Gemini 3.5 medium" adinda resmi/dokumante bir
# Google modeli bulunmamaktadir (07/2026 itibariyle). Google'in
# guncel model isimlendirmesi "gemini-2.5-pro", "gemini-2.5-flash"
# vb. seklindedir. Asagidaki degeri Google AI Studio'da
# (https://aistudio.google.com) o an gecerli/erisiminiz olan
# model ID'si ile degistirin. Kod bu degere baglidir, baska
# hicbir yerde model adi hardcode edilmemistir.
# ------------------------------------------------------------
GEMINI_MODEL_NAME=gemini-2.5-pro

# Dakikada izin verilen maksimum istek sayısı (RPM limiti)
GEMINI_RATE_LIMIT_RPM=15

# RAG'da referans olarak kaç geçmiş yorum getirilecek
RAG_TOP_K=3

# Backend port
BACKEND_PORT=8000
